<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Window-level theme shell only: all in-app colors are owned by Compose (ui/theme/).
         Platform parent (decoupled from the MDC dependency); minSdk24 has no Theme.*.DayNight (29+),
         so light/dark window background for the cold-start first frame is split via the values vs values-night parents.
         The windowLight* here is only the pre-first-frame value; enableEdgeToEdge overrides it from the effective theme. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="O_MR1">true</item>
    </style>

</resources>
